# Copy this file to .env and replace the placeholders with your own values.
# NEVER commit the real .env file.

# Server
APP_ENV=development
APP_PORT=3000

# Database (SQLite file, path is relative to the repository root)
DATABASE_PATH=data/pawfinder.db

# Authentication (used from AUTH-01 / AUTH-02 onward)
JWT_SECRET=replace_with_a_long_random_string
SESSION_EXPIRY_HOURS=24

# Password reset (AUTH-04)
# Where the website runs; reset links in emails point here.
APP_URL=http://localhost:5173
# How long a reset link stays valid.
RESET_TOKEN_MINUTES=60

# Photo storage (used from REP-01b onward)
UPLOAD_DIR=uploads
