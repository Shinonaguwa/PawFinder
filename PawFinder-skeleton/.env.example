# Spring Boot API
APP_PORT=3000

# MySQL 8. Create this database or leave createDatabaseIfNotExist enabled in application.properties.
DATABASE_URL=jdbc:mysql://localhost:3306/pawfinder?createDatabaseIfNotExist=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace_with_your_mysql_password

# Authentication. Use a random secret of at least 32 bytes outside development.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
SESSION_EXPIRY_HOURS=24

# Password reset
APP_URL=http://localhost:5173
RESET_TOKEN_MINUTES=60
