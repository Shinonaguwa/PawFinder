# Copy this file to .env and replace the placeholders with your own values.
# NEVER commit the real .env file.

# Server
APP_ENV=development
APP_PORT=3000

# Database (SQLite file, path is relative to the repository root)
DATABASE_PATH=data/pawfinder.db

# Authentication (used from AUTH-01 / AUTH-02 onward)
JWT_SECRET=replace_with_a_long_random_string
SESSION_EXPIRY_HOURS=24

# Photo storage (used from REP-01b onward)
UPLOAD_DIR=uploads
